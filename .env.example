POSTGRES_PASSWORD=your_postgres_password
CASE_API_KEY=your_case_api_key
N8N_ENCRYPTION_KEY=key for encrypting sensitive data in n8n. You can generate a random key using a secure method and paste it here.
N8N_HOST=yourdomain.com
GITHUB_TOKEN=you can generate a personal access token on GitHub and paste it here. Make sure to give it the necessary permissions for your use case.
CASE_REPOS=you can add your own repositories here, separated by commas. For example: user1/repo1,user2/repo2,user3/repo3
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
CASE_BRIEF_MODE=rules   # rules | command | all
