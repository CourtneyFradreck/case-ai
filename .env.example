POSTGRES_PASSWORD=your_postgres_password
CASE_API_KEY=your_case_api_key
N8N_ENCRYPTION_KEY=key for encrypting sensitive data in n8n. You can generate a random key using a secure method and paste it here.
N8N_HOST=yourdomain.com
GITHUB_TOKEN=you can generate a personal access token on GitHub and paste it here. Make sure to give it the necessary permissions for your use case.
# Optional: repos always read, even when quiet or not yours. Your own active repos are discovered.
CASE_REPOS=you can add your own repositories here, separated by commas. For example: user1/repo1,user2/repo2,user3/repo3
# Optional: owned repos never read (comma-separated globs on owner/repo or the bare name)
CASE_REPO_EXCLUDE=
# Discovered repos are read if pushed to within this many days
CASE_REPO_ACTIVE_DAYS=14
# Branch globs to skip (comma-separated); defaults to pr-assets/*
CASE_BRANCH_EXCLUDE=pr-assets/*
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# rules | command | all
CASE_BRIEF_MODE=rules
# --- Telegram (new) ---
TELEGRAM_CHAT_ID=5840249884
TELEGRAM_BOT_TOKEN=123456789:AA...same token as n8n's Telegram credential
# Leave unset (or n8n) for the first test, then switch to core
CASE_DELIVERY=n8n

# --- Backups (new) ---
BACKUP_REMOTE=r2:case-backups
BACKUP_AGE_RECIPIENT=age1...your public key
BACKUP_KEEP_DAYS=30
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional: set after you create the n8n backup-alert webhook
BACKUP_FAILURE_WEBHOOK=http://n8n:5678/webhook/backup-failed-<random hex>