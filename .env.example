POSTGRES_PASSWORD=your_postgres_password
CASE_API_KEY=your_case_api_key
N8N_ENCRYPTION_KEY=key for encrypting sensitive data in n8n. You can generate a random key using a secure method and paste it here.
N8N_HOST=yourdomain.com
GITHUB_TOKEN=you can generate a personal access token on GitHub and paste it here. Make sure to give it the necessary permissions for your use case.
CASE_REPOS=you can add your own repositories here, separated by commas. For example: user1/repo1,user2/repo2,user3/repo3
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# rules | command | all
CASE_BRIEF_MODE=rules

# --- Backups (optional) ---
# Leave BACKUP_REMOTE empty to disable backups; the backup container then idles.
# rclone destination as <remote>:<bucket>[/path], e.g. r2:case-backups.
# "r2" is configured by the R2_* variables below.
BACKUP_REMOTE=
# age public key (age1...). Make it on your laptop with `age-keygen -o case-backup.key`.
# The private key never goes on the server.
BACKUP_AGE_RECIPIENT=age1yourpublickey
# Backups dated more than this many days ago are deleted after each run.
BACKUP_KEEP_DAYS=30
# Optional: a failed run POSTs a short JSON message here (e.g. an n8n webhook that sends a Telegram message).
BACKUP_FAILURE_WEBHOOK=
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com and an R2 API token
# with Object Read & Write on the backup bucket only.
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
